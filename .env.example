# Copy to .env and adjust if needed.
# Local Docker Compose default:
DATABASE_URL=postgresql+psycopg://tablescore:tablescore@localhost:5432/tablescore

# Public site URL for canonical / Open Graph / sitemap (use https in production).
# SITE_URL=https://boardgameallstars.com

# Hosted Postgres often gives postgresql://... — the app rewrites that to postgresql+psycopg://
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
